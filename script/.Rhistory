### Importation du jeu de données
data <- read.table("https://r-stat-sc-donnees.github.io/ozone.txt",header=TRUE, stringsAsFactors = TRUE)
### résumé du jeu de données
summary(data)
### Visualisation des données
ggplot(ozone, aes(x = maxO3)) + # création de l'objet ggplot, en spécifiant ce qu'on veut en x
geom_histogram(bins =20) + # ajout d'une couche HISTOGRAMME, classes plus grossières
labs(title = "titre", x= "titre axe x") +
theme_minimal()
### Visualisation des données
ggplot(data, aes(x = maxO3)) + # création de l'objet ggplot, en spécifiant ce qu'on veut en x
geom_histogram(bins =20) + # ajout d'une couche HISTOGRAMME, classes plus grossières
labs(title = "titre", x= "titre axe x") +
theme_minimal()
geom_point(position = position_jitter(width = 0.05
# points, avec perturbation horizontale pour faciliter visu
labs(title ="Effet du vent sur le max d'ozone")
# points, avec perturbation horizontale pour faciliter visu
labs(title ="Effet du vent sur le max d'ozone")
### Effet du vent sur maxO3
ggplot(data, aes(x = vent,
y= maxO3,
fill=vent,
theme_bw() +
col=vent)) + # dans aes: ce qui DEPEND du jeu de données
### Effet du vent sur maxO3
ggplot(data, aes(x = vent,
y= maxO3,
fill=vent,
col=vent)) + # dans aes: ce qui DEPEND du jeu de données
geom_boxplot(outlier.shape=NA,alpha=0.4) + # alpha : transparence
geom_point(position = position_jitter(width = 0.05))+
theme_bw() +
labs(title ="Effet du vent sur le max d'ozone")
### Effet pluie sur maxO3
ggplot(data, aes(x = pluie,
y= maxO3,
fill=pluie,
col=pluie)) + # dans aes: ce qui DEPEND du jeu de données
geom_boxplot(outlier.shape=NA,alpha=0.4) + # alpha : transparence
geom_point(position = position_jitter(width = 0.05))+
theme_bw() +
labs(title ="Effet de la pluie sur le max d'ozone")
###### TEST STATISTIQUE #####
## test de conformité de moyenne, est ce que la moyenne est égale à 0 ?
t.test(ozone$maxO3)
###### TEST STATISTIQUE #####
## test de conformité de moyenne, est ce que la moyenne est égale à 0 ?
t.test(data$maxO3)
## 2) comparaison de deux moyennes
### test des variances
var.test(maxO3 ~ pluie, data = data, alternative = "two.sided")
